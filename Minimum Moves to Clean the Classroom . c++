#include <vector>
#include <string>
#include <queue>
#include <tuple>

using namespace std;

class Solution {
public:
    int minMoves(vector<string>& classroom, int energy) {
        int m = classroom.size();
        int n = classroom[0].size();
        
        
        vector<vector<int>> litter_id(m, vector<int>(n, -1));
        int start_x = 0, start_y = 0, litter_cnt = 0;
        
        for (int i = 0; i < m; ++i) {
            for (int j = 0; j < n; ++j) {
                if (classroom[i][j] == 'S') {
                    start_x = i;
                    start_y = j;
                } else if (classroom[i][j] == 'L') {
                    litter_id[i][j] = litter_cnt++;
                }
            }
        }
        
       
        if (litter_cnt == 0) {
            return 0;
        }
        
        
        int max_mask = 1 << litter_cnt;
        vector<vector<vector<vector<bool>>>> vis(
            m, vector<vector<vector<bool>>>(
                n, vector<vector<bool>>(
                    energy + 1, vector<bool>(max_mask, false)
                )
            )
        );
        
      
        queue<tuple<int, int, int, int>> q;
        
        
        int initial_mask = max_mask - 1;
        q.emplace(start_x, start_y, energy, initial_mask);
        vis[start_x][start_y][energy][initial_mask] = true;
        
        int directions[5] = {-1, 0, 1, 0, -1};
        int moves = 0;
        
        while (!q.empty()) {
            int sz = q.size();
            while (sz--) {
                auto [r, c, cur_energy, mask] = q.front();
                q.pop();
                
                
                if (mask == 0) {
                    return moves;
                }
                
                
                if (cur_energy <= 0) {
                    continue;
                }
                
                
                for (int d = 0; d < 4; ++d) {
                    int nr = r + directions[d];
                    int nc = c + directions[d + 1];
                    
                    
                    if (nr >= 0 && nr < m && nc >= 0 && nc < n && classroom[nr][nc] != 'X') {
                        
                        int next_energy = (classroom[nr][nc] == 'R') ? energy : cur_energy - 1;
                        
                       
                        int next_mask = mask;
                        if (classroom[nr][nc] == 'L') {
                            next_mask &= ~(1 << litter_id[nr][nc]);
                        }
                        
                        
                        if (!vis[nr][nc][next_energy][next_mask]) {
                            vis[nr][nc][next_energy][next_mask] = true;
                            q.emplace(nr, nc, next_energy, next_mask);
                        }
                    }
                }
            }
            moves++;
        }
        
        return -1; 
    }
};
